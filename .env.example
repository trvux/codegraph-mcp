# Copy thành .env trên VPS (không commit — đã có trong .gitignore), điền password thật.
POSTGRES_PASSWORD=

# Dùng trong mcp-server, trỏ vào container postgres ở docker-compose.yml.
# Nếu MCP server chạy trên máy local, host là domain/IP VPS, port 5433.
DATABASE_URL=postgres://codegraph_user:<POSTGRES_PASSWORD>@<vps-host>:5433/codegraph
